# ---- Supabase (Project Settings → API) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# ---- Database (Project Settings → Database → Connection string) ----
# Pooled (port 6543) for the app:
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Direct (port 5432) for migrations:
DATABASE_URL_DIRECT=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# ---- Who may log in (comma-separated) ----
ALLOWED_EMAILS=shardulsingh@upforgeconsulting.com

# ---- Claude (Console → API keys). Leave empty to run in mock mode. ----
ANTHROPIC_API_KEY=
# live | mock   (mock returns realistic fixtures and costs nothing)
CLAUDE_MODE=mock

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
